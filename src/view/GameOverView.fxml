<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400" prefWidth="830" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameOverController">

    <children>
        <!-- Background image -->
        <ImageView fitHeight="430" fitWidth="830" preserveRatio="false">
            <image>
                <Image url="@../image/main.png" />
            </image>
        </ImageView>

        <!-- Semi-transparent overlay -->
        <StackPane layoutX="0" layoutY="0" prefWidth="830" prefHeight="430" style="-fx-background-color: rgba(0,0,0,0.5);" />

        <!-- Glow (radial gradient) -->
        <Circle fx:id="glowCircle" centerX="415" centerY="175" radius="150" fill="transparent" />

        <!-- Main content container (animation target) -->
        <VBox fx:id="mainContainer" alignment="CENTER" spacing="15" layoutX="10" layoutY="30" prefWidth="800" prefHeight="290"
              style="-fx-background-color: rgba(0,0,0,0.0); -fx-background-radius: 20; -fx-padding: 20;">

            <!-- Title -->
            <Label fx:id="resultTitle" style="-fx-font-size: 50px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;" text="VICTORY!" />

            <!-- Subtitle (dynamic content) -->
            <Label fx:id="subTitle" style="-fx-font-size: 20px; -fx-text-fill: #ecf0f1;" text="You have successfully restored the auction house!" />

            <!-- Statistics -->
            <Label fx:id="infoLabel" style="-fx-font-size: 18px; -fx-text-fill: white;" text="Final Gold: 1,200,000  |  Days: 25" />

            <!-- Button area -->
            <VBox alignment="CENTER" spacing="12">
                <Button onAction="#handleRestart" style="-fx-background-color: #2ecc71; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 40; -fx-cursor: hand;" text="🔄 Restart Game" />
                <Button onAction="#handleExit" style="-fx-background-color: #e74c3c; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 40; -fx-cursor: hand;" text="🚪 Exit Game" />
            </VBox>
        </VBox>
    </children>
</AnchorPane>
