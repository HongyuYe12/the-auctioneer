<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400" prefWidth="830"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.IntroduceController">

    <children>

        <!-- Background image -->
        <ImageView fitHeight="480" fitWidth="895"
                   layoutX="-30" layoutY="-30"
                   preserveRatio="false">
            <image>
                <Image url="@../image/introduce.png"/>
            </image>
        </ImageView>

        <!-- Title -->
        <Label layoutX="286.0" layoutY="20.0"
               text="Game Introduction"
               style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 28px;">
            <font>
                <Font name="Century" size="28"/>
            </font>
        </Label>

        <!-- Back button -->
        <Button layoutX="700" layoutY="20"
                onAction="#handleBack"
                text="Back"
                style="-fx-background-color: rgba(0,0,0,0.5);
                       -fx-text-fill: white;
                       -fx-font-size: 16px;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

        <!-- Scroll area -->
        <ScrollPane layoutX="20" layoutY="70"
            prefHeight="310" prefWidth="790"
            style="-fx-background-color: transparent;
                   -fx-background: transparent;
                   -fx-vbar-policy: never;
                   -fx-hbar-policy: never;">
            <VBox spacing="15"
                  style="-fx-padding: 10;
                         -fx-background-color: transparent;">

                <Label text="Welcome to The Auctioneer!"
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="You have inherited a failing auction house. Your goal is to earn 10,000,000 gold coins within 30 days."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="Game Mechanics:"
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="• Explore different locations to discover unidentified artifacts."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="• Use energy to appraise artifacts (cost varies by rarity)."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="• Sell appraised artifacts at auctions held every 7 days."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="• Manage your energy, gold, and auction house level wisely."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="• Buy items from the shop to restore energy or unlock new areas."
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Label text="Good luck, auctioneer!"
                       wrapText="true"
                       style="-fx-text-fill: black; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            </VBox>
        </ScrollPane>

    </children>
</AnchorPane>
